{
  "name": "saas-analytics",
  "private": true,
  "type": "module",
  "bin": {
    "csa": "cli/csa.mjs"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "deploy": "npm run build:client && npm run build:web && wrangler deploy",
    "migrate": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "csa": "node cli/csa.mjs",
    "build:web": "rm -rf public/app && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "setup": "node scripts/setup.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@rrweb/record": "^2.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "rrweb-player": "^2.2.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3"
  },
  "description": "Product analytics for SaaS, entirely on Cloudflare: web analytics, funnels, revenue attribution, session replay, AI crawler tracking.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
