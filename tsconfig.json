{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"], "strict": true, "noUncheckedIndexedAccess": true,
    "noEmit": true, "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "config/**/*.ts"]
}
