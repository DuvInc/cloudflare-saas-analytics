# Only the local CLI reads this file (`npm run csa -- sync`, `-- today --live`). The Worker gets its
# configuration from wrangler.jsonc and its secrets from `wrangler secret put`, never from here.
#
#   cp .env.example .env
#
# `.env` is gitignored. A real environment variable always wins over the file.

# R2 read access for the CLI (R2 > Manage API tokens > Object Read only, on your bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: the public URL of your dashboard, used in the enrollment link `csa enroll` prints.
# `npm run setup` already writes it to wrangler.jsonc.
ANALYTICS_URL=
